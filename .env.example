# Canonical origin used in metadata, sitemap and hreflang.
NEXT_PUBLIC_SITE_URL=https://elvora.my

# Admin (see README "Admin"). Generate both with:
#   npm run admin:hash -- "your password"
# Without these the admin area refuses every login — the storefront is unaffected.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Contact channels ------------------------------------------------------
# Shown as WhatsApp and email buttons on product pages, the contact page, the
# header and the footer. Left empty, the site says the details are being
# finalised rather than showing a dead link or an invented number.
# The WhatsApp number may be local (012-345 6789) or international
# (+60 12-345 6789); both normalise to the same wa.me link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (optional) ---------------------------------------------------
# Without these the site runs on the compiled catalogue and in-memory orders,
# exactly as before. See docs/SUPABASE-SETUP.md.
# Use the POOLER connection string (port 6543), not the direct one (5432).
SUPABASE_DB_URL=

# Public values. SUPABASE_URL also allows uploaded photos through next/image,
# and both are used by `npm run db:verify` to prove anon access is denied.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Supabase Storage (product photos) -------------------------------------
# SECRET. Project Settings -> API -> service_role. Server-side only; it bypasses
# all database security, so it must never be prefixed with NEXT_PUBLIC_.
# Without it, photo uploads are refused (never faked) and the shop still works.
SUPABASE_SERVICE_ROLE_KEY=
