# Canonical origin used in metadata, sitemap and hreflang.
NEXT_PUBLIC_SITE_URL=https://elvora.my

# Admin (see README "Admin"). Generate both with:
#   npm run admin:hash -- "your password"
# Without these the admin area refuses every login — the storefront is unaffected.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Supabase (optional) ---------------------------------------------------
# Without these the site runs on the compiled catalogue and in-memory orders,
# exactly as before. See docs/SUPABASE-SETUP.md.
# Use the POOLER connection string (port 6543), not the direct one (5432).
SUPABASE_DB_URL=

# Public values, used only by `npm run db:verify` to prove anon access is denied.
SUPABASE_URL=
SUPABASE_ANON_KEY=
